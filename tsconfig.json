{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/loading.js",
    "src/components/shared/SearchBar.js",
    "src/lib/supabase/client.js",
    "src/components/home/CategoriesListClient.js",
    "src/components/home/CategoriesListServer.js",
    "src/components/shared/TitleHeading.js",
    "src/components/home/SocialPromote.js",
    "src/components/home/StudentComments.js",
    "src/components/shared/ThemeToggle.js",
    "src/components/shared/Newsletter.js",
    "src/providers/ThemeProvider.js"
  ],
  "exclude": ["node_modules"]
}
